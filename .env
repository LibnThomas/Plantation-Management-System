# Copy this file to .env and fill in your values
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.31.90
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pms.yourdomain.com

# PostgreSQL
DB_NAME=plantation_db
DB_USER=quantum
DB_PASSWORD=qt@123
DB_HOST=localhost
DB_PORT=5432
# DB_ENGINE=sqlite   # uncomment to try the app without PostgreSQL
# Demo mode keeps its sample data in a separate database (created automatically; the DB user
# needs the CREATEDB permission). Defaults to <DB_NAME>_demo
# DEMO_DB_NAME=plantation_db_demo
# With SQLite: SQLITE_PATH=db.sqlite3 and SQLITE_DEMO_PATH=db_demo.sqlite3

# Starting values only: copied into App Settings by the first migrate, then changed there
ESTATE_NAME=My Cardamom Estate
CURRENCY_SYMBOL=₹
TIME_ZONE=Asia/Kolkata
FINANCIAL_YEAR_START_MONTH=4
CROP_SEASON_START_MONTH=8
# On a server behind plain http (no https) set this to False, otherwise logins won't stick
# SECURE_COOKIES=True

# Renewal contact shown during the free trial
# LICENCE_SUPPORT_CONTACT=Mentors Soft Tech - phone / email
# Subscription API: default URL / token for "Update the valid till date from the API"
# SUBSCRIPTION_API_URL=https://licence.example.com/pms/green-valley.json
# SUBSCRIPTION_API_TOKEN=
# False = vendor-controlled: the API is always on and the admin can't type the date
# SUBSCRIPTION_MANUAL_ALLOWED=True
